@article{breine_fish-based_2004,
	title = {A fish-based index of biotic integrity for upstream brooks in {Flanders} ({Belgium})},
	volume = {522},
	issn = {0018-8158},
	url = {http://doi.org/10.1023/B:HYDR.0000029991.42922.a4},
	doi = {10.1023/B:HYDR.0000029991.42922.a4},
	abstract = {From 1994 to 2000, 154 sites belonging to the grayling and trout zones were used to develop a fish-based multimetric Index of Biotic Integrity (IBI) as a tool to assess upstream brooks in Flanders (Belgium). All sites had a slope of at least 3\%o and a maximum width of 4.5 m. Fish assemblages were surveyed by electrofishing. From 28 candidate metrics 9 metrics were selected using ecological criteria and statistica! analyses. The IBI was defined as the average of these 9 metrics after scoring them as 1, 3 or 5 by a modified trisection method and five integrity classes were defined to comply with the European Water Framework Directive (WFD). The IBI was tested intemally by comparison with habitat quality scores at sites. A similar comparison was done using an independent set of data from sites of known ecological quality. Our IBI clearly distinguished good sites from disturbed sites and heavily disturbed sites from moderately disturbed sites, thereby meeting the criteria imposed by the WFD.},
	language = {en},
	number = {1-3},
	urldate = {2025-05-15},
	journal = {Hydrobiologia},
	author = {Breine, Jan and Simoens, Ilse and Goethals, Peter and Quataert, Paul and Ercken, Dirk and Van Liefferinghe, Chris and Belpaire, Claude},
	month = jul,
	year = {2004},
	pages = {133--148},
	file = {Breine e.a. - 2004 - A fish-based index of biotic integrity for upstrea.pdf:C\:\\Users\\els_lommelen\\Zotero\\storage\\DIG6B7J7\\Breine e.a. - 2004 - A fish-based index of biotic integrity for upstrea.pdf:application/pdf},
}

